name: Github Actions Demo

run-name: ${{ github.actor }} esta ejecutando en pipeline 
 on [push]
 jobs:
  Saludar-Hello-World:
    runs-on: ubuntu-latest
    steps:
    - run: echo "Este jos ha sido ejecutado ${{ github.event_name}}"
    - run: echo "El nombre de la rama es ${{github.ref}} y el reposito es ${{github.repository}}"
